<Application x:Class="GameTranslatorIT.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:GameTranslatorIT.App.Converters"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:EnumEqualityConverter x:Key="EnumEqual" />
            <conv:StateToBrushConverter x:Key="StateBrush" />
            <DataTemplate x:Key="LanguageCodeTemplate">
                <TextBlock Text="{Binding Code}" Foreground="White" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </DataTemplate>
            <conv:LanguageTemplateSelector x:Key="LanguageSelector"
                                           LanguageTemplate="{StaticResource LanguageCodeTemplate}" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
