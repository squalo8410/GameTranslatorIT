<Window x:Class="GameTranslatorIT.App.Views.AudioDeviceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Seleziona dispositivo audio di uscita" Height="480" Width="560"
        MinHeight="380" MinWidth="460" WindowStartupLocation="CenterOwner"
        AutomationProperties.Name="Seleziona dispositivo audio di uscita">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="DISPOSITIVO AUDIO DI USCITA" Style="{StaticResource Heading}" FontSize="19" />
            <TextBlock Text="Scegli l'uscita usata per leggere i sottotitoli. Se il dispositivo è disattivato l'app prova ad abilitarlo; se è scollegato apre le impostazioni audio di Windows e lo usa appena diventa attivo."
                       Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <DockPanel LastChildFill="False">
                <Button Content="Aggiorna dispositivi" Command="{Binding RefreshAudioDevicesCommand}"
                        Margin="0,0,10,0" />
                <Button Content="Prova voce" Command="{Binding TestVoiceCommand}" />
            </DockPanel>
            <CheckBox Content="Mostra solo dispositivi attivi"
                      IsChecked="{Binding Settings.ShowOnlyActiveAudioDevices}"
                      Checked="Filter_Changed" Unchecked="Filter_Changed" Margin="0,8,0,0" />
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8">
            <ListBox x:Name="DeviceList" ItemsSource="{Binding VisibleAudioOutputDevices}"
                     DisplayMemberPath="DisplayName"
                     MouseDoubleClick="DeviceList_MouseDoubleClick"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
        </Border>

        <StackPanel Grid.Row="3" Margin="0,8,0,12">
            <TextBlock Text="{Binding PendingDeviceMessage}" TextWrapping="Wrap"
                       Foreground="{StaticResource App.Accent}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding SelectedItem.AvailabilityHint, ElementName=DeviceList}"
                       Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Ripristina consigliato" Click="Reset_Click" Margin="0,0,10,0" />
            <Button Content="Annulla" Click="Cancel_Click" Margin="0,0,10,0" />
            <Button Content="Collega / usa questo dispositivo" Click="Confirm_Click"
                    Style="{StaticResource PrimaryButton}" FontSize="13" Padding="14,8" />
        </StackPanel>
    </Grid>
</Window>
