<Window x:Class="GameTranslatorIT.App.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aggiornamento disponibile" Height="520" Width="640"
        MinHeight="440" MinWidth="560" WindowStartupLocation="CenterOwner"
        AutomationProperties.Name="Aggiornamento disponibile">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="AGGIORNAMENTO DISPONIBILE" Style="{StaticResource Heading}" FontSize="20" />
            <TextBlock x:Name="SummaryText" Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Avanzamento" Style="{StaticResource SubHeading}" Margin="0,0,0,8" />
                <ProgressBar x:Name="ProgressBar" Height="18" IsIndeterminate="False" Value="0" Maximum="100" />
                <TextBlock x:Name="StatusText" Text="In attesa della tua conferma."
                           Style="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Note della versione" Style="{StaticResource SubHeading}" Margin="0,0,0,8" />
                <TextBox x:Name="NotesBox" IsReadOnly="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                         Background="Transparent" Foreground="#FFC9D4DE" BorderThickness="0" />
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="IgnoreButton" Content="Ignora questa versione" Click="Ignore_Click" Margin="0,0,10,0" />
            <Button x:Name="OpenButton" Content="Apri pagina release" Click="OpenRelease_Click" Margin="0,0,10,0" />
            <Button x:Name="CancelButton" Content="Chiudi" Click="Cancel_Click" Margin="0,0,10,0" />
            <Button x:Name="ApplyButton" Content="Scarica e installa" Click="Apply_Click"
                    Style="{StaticResource PrimaryButton}" Padding="18,8" FontSize="13" />
        </StackPanel>
    </Grid>
</Window>
