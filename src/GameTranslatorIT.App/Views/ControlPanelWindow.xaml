<Window x:Class="GameTranslatorIT.App.Views.ControlPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:GameTranslatorIT.Core.Models;assembly=GameTranslatorIT.Core"
        Title="Pannello di controllo — GameTranslator IT" Height="760" Width="1020"
        MinHeight="620" MinWidth="880" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <x:Array x:Key="MuteModes" Type="models:RegionMuteMode">
            <models:RegionMuteMode>SoloVoce</models:RegionMuteMode>
            <models:RegionMuteMode>Blocca</models:RegionMuteMode>
            <models:RegionMuteMode>Accoda</models:RegionMuteMode>
        </x:Array>
        <x:Array x:Key="CaptureModes" Type="models:CaptureMode">
            <models:CaptureMode>FullScreen</models:CaptureMode>
            <models:CaptureMode>GameWindow</models:CaptureMode>
        </x:Array>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="PANNELLO DI CONTROLLO" Style="{StaticResource Heading}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0">
                        <Run Text="{Binding StatusText, Mode=OneWay}" />
                        <Run Text=" · " />
                        <Run Text="{Binding RegionsSummary, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="AVVIA" Style="{StaticResource PrimaryButton}"
                            Command="{Binding StartCommand}" Margin="0,0,8,0" Padding="16,10" FontSize="13" />
                    <Button Content="INTERROMPI" Style="{StaticResource StopButton}"
                            Command="{Binding StopCommand}" Margin="0,0,8,0" Padding="16,10" FontSize="13" />
                    <Button Content="Pannello rapido" Command="{Binding ToggleQuickControlCommand}"
                            Margin="0,0,8,0" />
                    <Button Content="Chiudi" Click="Close_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Background="Transparent" BorderBrush="{StaticResource App.Border}">
            <TabItem Header="Riquadri e muto">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="RIQUADRI DI LETTURA" Style="{StaticResource SubHeading}" />
                            <CheckBox Content="Usa più riquadri selezionati" IsChecked="{Binding UseCaptureRegions}" />
                            <DockPanel Margin="0,6,0,6">
                                <TextBlock Text="Numero di riquadri" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <ComboBox ItemsSource="{Binding RegionCounts}" SelectedItem="{Binding RegionCount}"
                                          Width="90" HorizontalAlignment="Left" />
                            </DockPanel>
                            <Button Content="Aggiungi riquadro" Command="{Binding AddRegionCommand}"
                                    HorizontalAlignment="Left" Margin="0,0,0,8" />
                            <TextBlock Text="{Binding RegionsSummary}" Style="{StaticResource Muted}" Margin="0,0,0,10" />

                            <ItemsControl ItemsSource="{Binding Regions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#18FFFFFF" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" IsChecked="{Binding Enabled, Mode=OneWay}"
                                                          Checked="RegionEnabled_Changed" Unchecked="RegionEnabled_Changed"
                                                          ToolTip="Riquadro attivo" Margin="0,0,8,0" />
                                                <CheckBox Grid.Column="1" IsChecked="{Binding Muted, Mode=OneWay}"
                                                          Checked="RegionMute_Changed" Unchecked="RegionMute_Changed"
                                                          ToolTip="Silenziato" Margin="0,0,8,0" />
                                                <TextBox Grid.Column="2" Text="{Binding Name, Mode=OneWay}"
                                                         LostFocus="RegionName_LostFocus" Margin="0,0,8,0" />
                                                <ComboBox Grid.Column="3" ItemsSource="{StaticResource MuteModes}"
                                                          SelectedItem="{Binding MuteMode, Mode=OneWay}"
                                                          SelectionChanged="RegionMode_Changed" Margin="0,0,8,0" />
                                                <Button Grid.Column="4" Content="Scegli" Command="{Binding DataContext.SelectRegionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" Margin="0,0,6,0" Padding="8,4" FontSize="11" />
                                                <Button Grid.Column="5" Content="Rimuovi" Command="{Binding DataContext.RemoveRegionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" Padding="8,4" FontSize="11" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="F1–F8: muto · Ctrl+F1–F8: seleziona · Ctrl+Shift+F1–F8: modalità · Ctrl+Alt+F1–F8: rimuovi"
                                       Style="{StaticResource Muted}" Margin="0,8,0,8" />
                            <CheckBox Content="Mostra il pannello rapido all'avvio"
                                      IsChecked="{Binding Settings.QuickControlAlwaysVisible}"
                                      Checked="QuickControlSetting_Changed" Unchecked="QuickControlSetting_Changed" />
                            <Button Content="Aggiorna monitor e finestre" Command="{Binding RefreshDevicesCommand}"
                                    HorizontalAlignment="Left" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Voce e audio">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="VOCE E DISPOSITIVO DI USCITA" Style="{StaticResource SubHeading}" />
                            <CheckBox Content="Leggi i sottotitoli a voce" IsChecked="{Binding VoiceEnabled, Mode=TwoWay}"
                                      Checked="VoiceSetting_Changed" Unchecked="VoiceSetting_Changed" />
                            <ToggleButton Content="{Binding VoiceToggleLabel}"
                                          IsChecked="{Binding VoiceEnabled, Mode=TwoWay}"
                                          Margin="0,6,0,4" Padding="8,6" />
                            <TextBlock Text="{Binding VoiceStatus.Message}" Style="{StaticResource Muted}" Margin="0,4,0,10" />

                            <TextBlock Text="Volume voce traduttore" Style="{StaticResource Muted}" />
                            <DockPanel Margin="0,0,0,10">
                                <Slider Minimum="0" Maximum="100" Value="{Binding Settings.VoiceVolume}"
                                        ValueChanged="VoiceSetting_Changed" />
                                <TextBlock Text="{Binding Settings.VoiceVolume, StringFormat={}{0}%}"
                                           Margin="12,0,0,0" VerticalAlignment="Center" MinWidth="44" />
                            </DockPanel>

                            <TextBlock Text="Velocità della voce" Style="{StaticResource Muted}" />
                            <DockPanel Margin="0,0,0,10">
                                <Slider Minimum="50" Maximum="200" Value="{Binding Settings.VoiceRate}"
                                        ValueChanged="VoiceSetting_Changed" />
                                <TextBlock Text="{Binding Settings.VoiceRate, StringFormat={}{0}%}"
                                           Margin="12,0,0,0" VerticalAlignment="Center" MinWidth="44" />
                            </DockPanel>

                            <TextBlock Text="Dispositivo audio di uscita" Style="{StaticResource Muted}" Margin="0,4,0,4" />
                            <ComboBox ItemsSource="{Binding VisibleAudioOutputDevices}"
                                      SelectedItem="{Binding ChosenAudioOutputDevice}" DisplayMemberPath="DisplayName"
                                      ToolTip="Qualsiasi uscita è selezionabile: se non è attiva l'app proverà a collegarla">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="ToolTip" Value="{Binding AvailabilityHint}" />
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>
                            <CheckBox Content="Mostra solo dispositivi attivi"
                                      IsChecked="{Binding Settings.ShowOnlyActiveAudioDevices}"
                                      Checked="ActiveAudioFilter_Changed" Unchecked="ActiveAudioFilter_Changed"
                                      Margin="0,6,0,0" />
                            <Button Content="Aggiorna dispositivi audio" Command="{Binding RefreshAudioDevicesCommand}"
                                    HorizontalAlignment="Left" Margin="0,8,0,4" />
                            <Button Content="Prova voce" Command="{Binding TestVoiceCommand}"
                                    HorizontalAlignment="Left" Margin="0,0,0,10" />

                            <TextBlock Text="{Binding VolumeLabel}" Style="{StaticResource Muted}" />
                            <DockPanel Margin="0,0,0,8">
                                <Slider Minimum="0" Maximum="100" Value="{Binding SystemVolume, Mode=TwoWay}" />
                                <TextBlock Text="{Binding SystemVolume, StringFormat={}{0}%}"
                                           Margin="12,0,0,0" VerticalAlignment="Center" MinWidth="44" />
                            </DockPanel>
                            <ToggleButton Content="Muto audio di sistema (Windows)"
                                          IsChecked="{Binding SystemMuted, Mode=OneWay}"
                                          Command="{Binding ToggleSystemMuteCommand}" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Cattura e OCR">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="AREA DI CATTURA" Style="{StaticResource SubHeading}" />
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="Modalità" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <ComboBox ItemsSource="{StaticResource CaptureModes}"
                                          SelectedItem="{Binding Settings.CaptureMode}"
                                          SelectionChanged="CaptureSetting_Changed" Width="220" HorizontalAlignment="Left" />
                            </DockPanel>
                            <TextBlock Text="Monitor" Style="{StaticResource Muted}" />
                            <ListBox ItemsSource="{Binding Monitors}" DisplayMemberPath="Name"
                                     SelectedIndex="{Binding Settings.SelectedMonitorIndex}"
                                     SelectionChanged="CaptureSetting_Changed" Height="86" Margin="0,0,0,8" />
                            <TextBlock Text="Finestra di gioco" Style="{StaticResource Muted}" />
                            <ListBox ItemsSource="{Binding Windows}" DisplayMemberPath="Title"
                                     SelectedValuePath="Title" SelectedValue="{Binding Settings.SelectedWindowTitle}"
                                     SelectionChanged="CaptureSetting_Changed" Height="86" Margin="0,0,0,10" />

                            <TextBlock Text="Intervallo di acquisizione (ms)" Style="{StaticResource Muted}" />
                            <TextBox Text="{Binding Settings.UpdateIntervalMs, UpdateSourceTrigger=LostFocus}"
                                     LostFocus="CaptureSetting_LostFocus" Margin="0,0,0,8" />
                            <TextBlock Text="Sensibilità OCR (%)" Style="{StaticResource Muted}" />
                            <TextBox Text="{Binding Settings.OcrSensitivity, UpdateSourceTrigger=LostFocus}"
                                     LostFocus="CaptureSetting_LostFocus" Margin="0,0,0,8" />
                            <TextBlock Text="Ingrandimento OCR (%)" Style="{StaticResource Muted}" />
                            <TextBox Text="{Binding Settings.OcrUpscalePercent, UpdateSourceTrigger=LostFocus}"
                                     LostFocus="CaptureSetting_LostFocus" Margin="0,0,0,10" />

                            <Button Content="Aggiorna monitor e finestre" Command="{Binding RefreshDevicesCommand}"
                                    HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding CaptureStatus.Message}" Style="{StaticResource Muted}" Margin="0,8,0,2" />
                            <TextBlock Text="{Binding OcrStatus.Message}" Style="{StaticResource Muted}" />
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Traduzione e log">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="SERVIZIO DI TRADUZIONE LOCALE" Style="{StaticResource SubHeading}" />
                            <TextBlock Text="Indirizzo LibreTranslate" Style="{StaticResource Muted}" />
                            <TextBox Text="{Binding Settings.LocalTranslateBaseUrl, UpdateSourceTrigger=LostFocus}"
                                     LostFocus="TranslationSetting_LostFocus" Margin="0,0,0,8" />
                            <TextBlock Text="Timeout (ms)" Style="{StaticResource Muted}" />
                            <TextBox Text="{Binding Settings.TranslationTimeoutMs, UpdateSourceTrigger=LostFocus}"
                                     LostFocus="TranslationSetting_LostFocus" Margin="0,0,0,8" />
                            <DockPanel Margin="0,0,0,10">
                                <Button Content="Verifica traduzione locale" Command="{Binding TestTranslationCommand}" />
                                <Button Content="Impostazioni complete" Command="{Binding OpenSettingsCommand}"
                                        Margin="8,0,0,0" />
                            </DockPanel>
                            <TextBlock Text="{Binding TranslationStatus.Message}" Style="{StaticResource Muted}" Margin="0,0,0,10" />
                            <TextBlock Text="Glossario" Style="{StaticResource Muted}" />
                            <TextBox Text="{Binding Settings.GlossaryPath}" IsReadOnly="True" Margin="0,0,0,12" />

                            <TextBlock Text="REGISTRO EVENTI" Style="{StaticResource SubHeading}" />
                            <ListBox ItemsSource="{Binding LogEntries}" Height="230" />
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
