<Window x:Class="GameTranslatorIT.App.Views.QuickControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Controllo rapido" Width="320" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize">

    <Border Background="#F0181E24" BorderBrush="#FF2C3742" BorderThickness="1"
            CornerRadius="12" Padding="14">
        <StackPanel>
            <Grid MouseLeftButtonDown="DragArea_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="CONTROLLO RAPIDO" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource App.Accent}" />
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="✕" Click="Close_Click" Padding="6,2" FontSize="12" />
            </Grid>

            <Grid Margin="0,10,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="AVVIA" Style="{StaticResource PrimaryButton}"
                        Command="{Binding StartCommand}" Margin="0,0,4,0" Padding="8,8" FontSize="12" />
                <Button Grid.Column="1" Content="FERMA" Style="{StaticResource StopButton}"
                        Command="{Binding StopCommand}" Margin="4,0,0,0" Padding="8,8" FontSize="12" />
            </Grid>

            <TextBlock Text="Volume Windows" Style="{StaticResource Muted}" />
            <DockPanel Margin="0,0,0,6">
                <Slider Minimum="0" Maximum="100" Value="{Binding SystemVolume, Mode=TwoWay}" />
                <TextBlock Text="{Binding SystemVolume, StringFormat={}{0}%}" Margin="8,0,0,0"
                           VerticalAlignment="Center" MinWidth="38" />
            </DockPanel>
            <ToggleButton Content="Muto audio" IsChecked="{Binding SystemMuted, Mode=OneWay}"
                          Command="{Binding ToggleSystemMuteCommand}" HorizontalAlignment="Stretch"
                          Margin="0,0,0,8" Padding="8,6" />

            <TextBlock Text="Modalità lettura" Style="{StaticResource Muted}" />
            <ToggleButton Content="{Binding VoiceToggleLabel}"
                          IsChecked="{Binding VoiceEnabled, Mode=TwoWay}"
                          HorizontalAlignment="Stretch" Margin="0,0,0,8" Padding="8,6" />

            <TextBlock Text="Volume voce" Style="{StaticResource Muted}" />
            <DockPanel Margin="0,0,0,8">
                <Slider Minimum="0" Maximum="100" Value="{Binding Settings.VoiceVolume}"
                        ValueChanged="VoiceSetting_Changed" />
                <TextBlock Text="{Binding Settings.VoiceVolume, StringFormat={}{0}%}" Margin="8,0,0,0"
                           VerticalAlignment="Center" MinWidth="38" />
            </DockPanel>

            <TextBlock Text="RIQUADRI" Style="{StaticResource SubHeading}" Margin="0,4,0,4" />
            <ItemsControl ItemsSource="{Binding Regions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{Binding Muted, Mode=OneWay}"
                                      Checked="RegionMute_Changed" Unchecked="RegionMute_Changed"
                                      Margin="0,0,8,0" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                                       FontWeight="SemiBold" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Content="Apri pannello completo" Command="{Binding DataContext.OpenControlPanelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    Margin="0,8,0,0" Padding="8,6" FontSize="12" />
        </StackPanel>
    </Border>
</Window>
