<Window x:Class="GameTranslatorIT.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:GameTranslatorIT.Core.Models;assembly=GameTranslatorIT.Core"
        Title="Impostazioni — GameTranslator IT" Height="780" Width="720"
        MinHeight="640" MinWidth="620" WindowStartupLocation="Manual">

    <Window.Resources>
        <x:Array x:Key="MuteModes" Type="models:RegionMuteMode">
            <models:RegionMuteMode>SoloVoce</models:RegionMuteMode>
            <models:RegionMuteMode>Blocca</models:RegionMuteMode>
            <models:RegionMuteMode>Accoda</models:RegionMuteMode>
        </x:Array>

        <!-- Elenco: codice BCP-47 + nome italiano. -->
        <DataTemplate x:Key="LanguageItemTemplate">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Code}" Foreground="{StaticResource App.Text}" FontWeight="SemiBold" />
                <TextBlock Text=" — " Foreground="{StaticResource App.Text}" />
                <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource App.Text}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Impostazioni" Style="{StaticResource Heading}" />
            <TextBlock Text="Le modifiche vengono salvate solo dopo aver premuto Salva." Style="{StaticResource Muted}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
            <StackPanel>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="LINGUE E TRADUZIONE" Style="{StaticResource SubHeading}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Lingua sorgente" VerticalAlignment="Center" />
                            <ComboBox x:Name="SourceLanguageCombo" Grid.Row="0" Grid.Column="1"
                                      ItemTemplate="{StaticResource LanguageItemTemplate}"
                                      SelectedValuePath="Code"
                                      SelectedValue="{Binding SourceLanguage}" Margin="0,3"
                                      Background="Black" Foreground="White"
                                      ToolTip="Tutte le lingue disponibili; il codice è quello salvato nelle impostazioni">
                                <ComboBox.Resources>
                                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                        <Setter Property="Background" Value="Black" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Style.Triggers>
                                            <Trigger Property="IsHighlighted" Value="True">
                                                <Setter Property="Background" Value="Black" />
                                                <Setter Property="Foreground" Value="White" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="Black" />
                                                <Setter Property="Foreground" Value="White" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ComboBox.Resources>
                            </ComboBox>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Lingua target" VerticalAlignment="Center" />
                            <ComboBox x:Name="TargetLanguageCombo" Grid.Row="1" Grid.Column="1"
                                      ItemTemplate="{StaticResource LanguageItemTemplate}"
                                      SelectedValuePath="Code"
                                      SelectedValue="{Binding TargetLanguage}" Margin="0,3"
                                      Background="Black" Foreground="White"
                                      ToolTip="Tutte le lingue disponibili; il codice è quello salvato nelle impostazioni">
                                <ComboBox.Resources>
                                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                        <Setter Property="Background" Value="Black" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Style.Triggers>
                                            <Trigger Property="IsHighlighted" Value="True">
                                                <Setter Property="Background" Value="Black" />
                                                <Setter Property="Foreground" Value="White" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="Black" />
                                                <Setter Property="Foreground" Value="White" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ComboBox.Resources>
                            </ComboBox>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="URL servizio locale" VerticalAlignment="Center" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding LocalTranslateBaseUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Timeout (ms)" VerticalAlignment="Center" />
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding TranslationTimeoutMs, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Lingua OCR (lettura)" VerticalAlignment="Center" />
                            <ComboBox x:Name="OcrLanguageCombo" Grid.Row="4" Grid.Column="1"
                                      ItemTemplate="{StaticResource LanguageItemTemplate}"
                                      SelectedValuePath="Code" SelectedValue="{Binding OcrLanguage}"
                                      Margin="0,3" Background="Black" Foreground="White"
                                      ToolTip="Riconoscitore Windows usato per leggere i sottotitoli. Serve quando la lingua di traduzione è 'auto'." />

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Fallback online" VerticalAlignment="Center" />
                            <CheckBox x:Name="OnlineFallbackCheck" Grid.Row="5" Grid.Column="1"
                                      Content="Usa la rete solo per le 8 lingue senza modello locale"
                                      IsChecked="{Binding AllowOnlineFallbackForMissingLanguages}"
                                      Checked="OnlineFallback_Changed" Unchecked="OnlineFallback_Changed"
                                      Foreground="White" Margin="0,3" />
                        </Grid>
                        <Button Content="Installa altre lingue OCR di Windows…" HorizontalAlignment="Left"
                                Margin="0,8,0,0" Padding="8,4" Click="InstallOcrLanguages_Click" />
                        <TextBlock x:Name="LanguageInfoText" Style="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap">
                            Caricamento informazioni sulle lingue…
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="OVERLAY E SOTTOTITOLI" Style="{StaticResource SubHeading}" />
                        <TextBlock Text="Dimensione testo" Style="{StaticResource Muted}" />
                        <DockPanel>
                            <Slider x:Name="FontSizeSlider" Minimum="16" Maximum="64" SmallChange="1" LargeChange="4"
                                    Value="{Binding SubtitleFontSize}" Width="360" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Value, ElementName=FontSizeSlider, StringFormat={}{0} px}"
                                       Margin="12,0,0,0" VerticalAlignment="Center" />
                        </DockPanel>

                        <TextBlock Text="Posizione" Style="{StaticResource Muted}" Margin="0,10,0,4" />
                        <ComboBox x:Name="OverlayPositionCombo" DisplayMemberPath="." SelectedItem="{Binding OverlayPosition}" />

                        <Grid Margin="0,10,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Colore testo (HEX)" VerticalAlignment="Center" />
                            <TextBox x:Name="TextColorBox" Grid.Row="0" Grid.Column="1" Text="{Binding TextColor, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Colore sfondo (HEX)" VerticalAlignment="Center" Margin="0,8,0,0" />
                            <TextBox x:Name="BackgroundColorBox" Grid.Row="1" Grid.Column="1" Text="{Binding BackgroundColor, UpdateSourceTrigger=PropertyChanged}" Margin="0,11,0,0" />
                        </Grid>

                        <TextBlock Text="Opacità sfondo" Style="{StaticResource Muted}" Margin="0,12,0,0" />
                        <DockPanel>
                            <Slider Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                                    Value="{Binding BackgroundOpacity}" Width="360" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding BackgroundOpacity, StringFormat={}{0:P0}}" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </DockPanel>

                        <CheckBox Content="Mostra anche il testo inglese originale" IsChecked="{Binding ShowOriginalAndTranslation}" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="ACQUISIZIONE E OCR" Style="{StaticResource SubHeading}" />
                        <TextBlock Text="Intervallo aggiornamento" Style="{StaticResource Muted}" />
                        <DockPanel>
                            <Slider Minimum="100" Maximum="2000" SmallChange="50" LargeChange="250"
                                    Value="{Binding UpdateIntervalMs}" Width="360" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding UpdateIntervalMs, StringFormat={}{0} ms}" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="Sensibilità OCR" Style="{StaticResource Muted}" Margin="0,12,0,0" />
                        <DockPanel>
                            <Slider Minimum="0" Maximum="100" SmallChange="1" LargeChange="10"
                                    Value="{Binding OcrSensitivity}" Width="360" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding OcrSensitivity, StringFormat={}{0}}" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="Ingrandimento OCR" Style="{StaticResource Muted}" Margin="0,12,0,0" />
                        <DockPanel>
                            <Slider Minimum="100" Maximum="400" SmallChange="25" LargeChange="50"
                                    Value="{Binding OcrUpscalePercent}" Width="360" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding OcrUpscalePercent, StringFormat={}{0}%}" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </DockPanel>

                        <CheckBox Content="Usa area sottotitoli manuale (valori relativi 0–1)"
                                  IsChecked="{Binding UseManualSubtitleRegion}" Margin="0,12,0,4" />
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding ManualRegionLeft, StringFormat=F2, UpdateSourceTrigger=PropertyChanged}" ToolTip="Sinistra" Margin="0,0,6,0" />
                            <TextBox Grid.Column="1" Text="{Binding ManualRegionTop, StringFormat=F2, UpdateSourceTrigger=PropertyChanged}" ToolTip="Alto" Margin="0,0,6,0" />
                            <TextBox Grid.Column="2" Text="{Binding ManualRegionWidth, StringFormat=F2, UpdateSourceTrigger=PropertyChanged}" ToolTip="Larghezza" Margin="0,0,6,0" />
                            <TextBox Grid.Column="3" Text="{Binding ManualRegionHeight, StringFormat=F2, UpdateSourceTrigger=PropertyChanged}" ToolTip="Altezza" />
                        </Grid>

                        <TextBlock Text="Percorso glossario (testo .txt, una voce per riga)" Style="{StaticResource Muted}" Margin="0,12,0,4" />
                        <DockPanel>
                            <TextBox Text="{Binding GlossaryPath, UpdateSourceTrigger=PropertyChanged}" DockPanel.Dock="Left" />
                            <Button Content="Sfoglia…" Click="BrowseGlossary_Click" Margin="8,0,0,0" />
                        </DockPanel>
                    </StackPanel>
                </Border>


                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="RIQUADRI DI LETTURA" Style="{StaticResource SubHeading}" />
                        <CheckBox Content="Usa i riquadri selezionati invece di un'unica area"
                                  IsChecked="{Binding UseCaptureRegions}" Margin="0,8,0,4" />
                        <CheckBox Content="Abilita i tasti rapidi globali (F1–F12)"
                                  IsChecked="{Binding HotkeysEnabled}" Margin="0,0,0,8" />

                        <TextBlock Text="Numero di riquadri (4 o 6 consigliati)" Style="{StaticResource Muted}" />
                        <ComboBox x:Name="RegionCountCombo" Width="100" HorizontalAlignment="Left"
                                  SelectedValue="{Binding RegionCount}" Margin="0,4,0,10" />

                        <ItemsControl ItemsSource="{Binding CaptureRegions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#18FFFFFF" CornerRadius="4" Padding="8" Margin="0,0,0,6">
                                        <StackPanel>
                                            <DockPanel>
                                                <CheckBox Content="Attivo" IsChecked="{Binding Enabled}"
                                                          DockPanel.Dock="Right" Margin="8,0,0,0" />
                                                <CheckBox Content="Muto" IsChecked="{Binding Muted}"
                                                          DockPanel.Dock="Right" Margin="8,0,0,0" />
                                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                         FontWeight="SemiBold" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding Coordinates}" Style="{StaticResource Muted}"
                                                       Margin="0,4,0,6" />
                                            <DockPanel>
                                                <ComboBox ItemsSource="{Binding Source={StaticResource MuteModes}}"
                                                          SelectedItem="{Binding MuteMode}" Width="120"
                                                          ToolTip="Cosa fa il muto su questo riquadro"
                                                          DockPanel.Dock="Right" />
                                                <Button Content="Rimuovi selezione" Click="RemoveRegionSetting_Click"
                                                        Margin="0,0,8,0" DockPanel.Dock="Right" />
                                                <Button Content="Seleziona con il mouse…" Click="SelectRegionSetting_Click"
                                                        HorizontalAlignment="Left" />
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap">
                            Con "Solo voce" la traduzione resta visibile ma non viene letta.
                            "Blocca" sospende del tutto il riquadro. "Accoda" salva le frasi cambiate
                            e le legge quando togli il muto: utile per le missioni ferme.
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="AUDIO" Style="{StaticResource SubHeading}" />
                        <CheckBox Content="Leggi i sottotitoli a voce" IsChecked="{Binding VoiceEnabled}" />
                        <TextBlock Text="Volume voce traduttore" Style="{StaticResource Muted}" Margin="0,10,0,4" />
                        <DockPanel>
                            <Slider Minimum="0" Maximum="100" SmallChange="1" LargeChange="10"
                                    Value="{Binding VoiceVolume}" Width="360" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding VoiceVolume, StringFormat={}{0}%}" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="Velocità della voce" Style="{StaticResource Muted}" Margin="0,10,0,4" />
                        <DockPanel>
                            <Slider Minimum="50" Maximum="200" SmallChange="5" LargeChange="25"
                                    Value="{Binding VoiceRate}" Width="360" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding VoiceRate, StringFormat={}{0}%}" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="Dispositivo audio di uscita" Style="{StaticResource Muted}" Margin="0,10,0,4" />
                        <DockPanel>
                            <ComboBox x:Name="AudioOutputCombo" DisplayMemberPath="DisplayName" Width="360"
                                      VerticalAlignment="Center"
                                      ToolTip="Dispositivo usato dalla voce e dal controllo volume">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="ToolTip" Value="{Binding AvailabilityHint}" />
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>
                            <Button Content="Aggiorna" Click="RefreshAudioDevices_Click" Margin="8,0,0,0" />
                        </DockPanel>
                        <CheckBox x:Name="AudioOnlyActiveCheck" Content="Mostra solo dispositivi attivi"
                                  IsChecked="{Binding ShowOnlyActiveAudioDevices}"
                                  Checked="ActiveAudioFilter_Changed" Unchecked="ActiveAudioFilter_Changed"
                                  Margin="0,6,0,0" />
                        <CheckBox Content="Riproduci la voce su tutte le uscite attive"
                                  IsChecked="{Binding PlayOnAllAudioDevices}" Margin="0,6,0,0" />
                        <TextBlock Text="Voce TTS" Style="{StaticResource Muted}" Margin="0,10,0,4" />
                        <ComboBox x:Name="TtsVoiceCombo" DisplayMemberPath="DisplayName" Width="360"
                                  ToolTip="Tutte le voci installate in Windows" />
                        <TextBlock Text="Microfono / ingresso audio" Style="{StaticResource Muted}" Margin="0,10,0,4" />
                        <ComboBox x:Name="AudioInputCombo" DisplayMemberPath="DisplayName" Width="360"
                                  ToolTip="Tutti gli ingressi audio rilevati da Windows" />
                        <TextBlock Text="Volume del dispositivo selezionato" Style="{StaticResource Muted}" Margin="0,10,0,4" />
                        <DockPanel>
                            <Slider Minimum="0" Maximum="100" SmallChange="1" LargeChange="10"
                                    Value="{Binding SystemVolume}" Width="360" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SystemVolume, StringFormat={}{0}%}" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="AGGIORNAMENTI" Style="{StaticResource SubHeading}" />
                        <CheckBox Content="Controlla aggiornamenti all'avvio" IsChecked="{Binding CheckForUpdatesOnStartup}" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Intervallo controllo (ore)" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBox Grid.Column="1" x:Name="UpdateIntervalHoursBox"
                                     Text="{Binding UpdateCheckIntervalHours, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalAlignment="Center" ToolTip="Da 1 a 168 ore" />
                        </Grid>
                        <TextBlock Text="Token GitHub (solo per release private)" Style="{StaticResource Muted}"
                                   Margin="0,10,0,4" />
                        <DockPanel>
                            <PasswordBox x:Name="GitHubTokenBox" PasswordChar="●" Width="360"
                                         VerticalAlignment="Center"
                                         ToolTip="Token personale con permesso di lettura del repository. Serve solo per release private." />
                            <CheckBox x:Name="ShowGitHubTokenCheck" Content="Mostra" Margin="8,0,0,0"
                                      VerticalAlignment="Center" Click="ShowGitHubToken_Changed" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap">
                            La traduzione resta locale. Solo il controllo aggiornamenti contatta GitHub Releases;
                            se la rete non è disponibile l'app continua a funzionare. Il token, se inserito, resta
                            nel tuo profilo Windows e non viene mai incluso negli asset pubblicati. La variabile
                            GITHUB_TOKEN, se presente, ha la priorità su questo campo. Una bozza privata non è
                            rilevata dall'aggiornamento automatico: per scaricare da solo serve una release pubblicata.
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="SCHERMO INTERO ESCLUSIVO" Style="{StaticResource SubHeading}" />
                        <CheckBox Content="Avvisa quando viene rilevata la modalità schermo intero esclusivo"
                                  IsChecked="{Binding WarnOnExclusiveFullscreen}" />
                        <TextBlock Text="Fallback quando l'overlay non è visibile" Style="{StaticResource Muted}" Margin="0,10,0,4" />
                        <ComboBox x:Name="OverlayFallbackCombo" DisplayMemberPath="." SelectedItem="{Binding OverlayFallback}" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0">
                            In schermo intero esclusivo una finestra normale non può essere composta sopra il gioco.
                            Il fallback consigliato usa un monitor secondario; se l'overlay resta coperto,
                            puoi attivare anche la lettura vocale o usare solo la voce.
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Annulla" Click="Cancel_Click" Width="110" Margin="0,0,10,0" IsCancel="True" />
            <Button Content="Salva" Click="Save_Click" Width="110" Style="{StaticResource PrimaryButton}" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
