<Window x:Class="GameTranslatorIT.App.Views.OverlayGeometryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Posizione e dimensione overlay" Height="400" Width="520"
        MinHeight="360" MinWidth="460" WindowStartupLocation="CenterOwner"
        AutomationProperties.Name="Posizione e dimensione overlay">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="OVERLAY TRADUZIONI" Style="{StaticResource Heading}" FontSize="19" />
            <TextBlock Text="Scegli esattamente dove compare il testo tradotto e quanto deve essere grande. I valori sono in pixel sullo schermo."
                       Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18">
            <StackPanel>
                <TextBlock Text="Posizione" Style="{StaticResource SubHeading}" Margin="0,0,0,8" />
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="100" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="X (sinistra):" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox Grid.Column="1" x:Name="LeftBox" VerticalAlignment="Center"
                             AutomationProperties.Name="Posizione X" ToolTip="Distanza dal bordo sinistro" />
                    <TextBlock Grid.Column="2" Text="Y (alto):" VerticalAlignment="Center" Margin="18,0,10,0" />
                    <TextBox Grid.Column="3" x:Name="TopBox" VerticalAlignment="Center"
                             AutomationProperties.Name="Posizione Y" ToolTip="Distanza dal bordo superiore" />
                </Grid>

                <TextBlock Text="Dimensione" Style="{StaticResource SubHeading}" Margin="0,0,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="100" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Larghezza:" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox Grid.Column="1" x:Name="WidthBox" VerticalAlignment="Center"
                             AutomationProperties.Name="Larghezza overlay" ToolTip="Larghezza in pixel (minimo 360)" />
                    <TextBlock Grid.Column="2" Text="Altezza:" VerticalAlignment="Center" Margin="18,0,10,0" />
                    <TextBox Grid.Column="3" x:Name="HeightBox" VerticalAlignment="Center"
                             AutomationProperties.Name="Altezza overlay" ToolTip="Altezza in pixel (minimo 90)" />
                </Grid>

                <TextBlock Text="Puoi anche usare 'Sblocca / blocca overlay': trascina il riquadro e ridimensionalo con il quadratino in basso a destra."
                           Style="{StaticResource Muted}" Margin="0,18,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Ripristina consigliato" Click="Reset_Click" Margin="0,0,10,0" />
            <Button Content="Annulla" Click="Cancel_Click" Margin="0,0,10,0" />
            <Button Content="Applica" Click="Apply_Click" Style="{StaticResource PrimaryButton}"
                    Padding="16,8" FontSize="13" />
        </StackPanel>
    </Grid>
</Window>
