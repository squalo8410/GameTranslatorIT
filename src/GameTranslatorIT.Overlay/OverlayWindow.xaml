<Window x:Class="GameTranslatorIT.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameTranslator IT Overlay" Height="180" Width="900"
        MinHeight="80" MaxHeight="520"
        SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize">

    <Grid>
        <Border x:Name="RootBorder" CornerRadius="10" Padding="18,14" Background="#CC000000"
                MouseLeftButtonDown="RootBorder_MouseLeftButtonDown">
            <ItemsControl x:Name="RegionItems">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,10" FlowDirection="{Binding BlockFlow}">
                            <TextBlock Text="{Binding Header}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{Binding HeaderBrush}" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding Original}" FontSize="{Binding OriginalFontSize}"
                                       FontFamily="{Binding UnicodeFont}" FlowDirection="{Binding OriginalFlow}"
                                       Foreground="{Binding Foreground}" TextWrapping="Wrap"
                                       Visibility="{Binding OriginalVisibility}" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding Translated}" FontSize="{Binding FontSize}"
                                       FontFamily="{Binding UnicodeFont}" FlowDirection="{Binding TextFlow}"
                                       LineHeight="{Binding LineHeight}" Foreground="{Binding Foreground}"
                                       TextWrapping="Wrap" FontWeight="SemiBold" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <Border x:Name="ResizeGrip" Width="18" Height="18" CornerRadius="3"
                Background="#80FF8A1F" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,4,4" Visibility="Collapsed" Cursor="SizeNWSE"
                MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown"
                MouseMove="ResizeGrip_MouseMove"
                MouseLeftButtonUp="ResizeGrip_MouseLeftButtonUp" />
    </Grid>
</Window>
