<Project>

  <!-- Unica fonte di verità per la versione dell'applicazione e degli installer. -->
  <PropertyGroup>
    <Version>1.0.9</Version>
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <FileVersion>$(Version).0</FileVersion>
    <Company>GameTranslator IT</Company>
    <Product>GameTranslator IT</Product>
    <!-- Nessun percorso assoluto del PC di sviluppo nei PDB/binari distribuiti. -->
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=/GameTranslatorIT/$(MSBuildProjectName)</PathMap>
  </PropertyGroup>

</Project>
